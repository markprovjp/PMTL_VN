# ===================================
# Development Environment Variables
# ===================================

# Node environment
NODE_ENV=development

# Database Configuration
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=dev_password_change_this
DATABASE_PORT=5432

# Backend Configuration
BACKEND_PORT=1337

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis / Queue
REDIS_ENABLED=true
REDIS_PORT=6379
BULLMQ_ENABLED=true
PUSH_WORKER_SECRET=dev_push_secret

# Strapi Keys (generate new ones for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=default_dev_key
API_TOKEN_SALT=default_dev_salt
ADMIN_JWT_SECRET=default_dev_jwt_secret
JWT_SECRET=default_dev_jwt
TRANSFER_TOKEN_SALT=default_dev_transfer_salt

# Email Configuration (optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pmtl.vn
SMTP_FROM_NAME=PMTL Admin
