# ===================================
# 2GB RAM VPS Optimized Environment
# ===================================

# Node environment
NODE_ENV=production

# Database Configuration - OPTIMIZED for 2GB
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DATABASE_PORT=5432
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5

# Backend Configuration
BACKEND_PORT=1337

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Strapi Keys - GENERATE NEW!
APP_KEYS=YOUR_APP_KEYS_HERE
API_TOKEN_SALT=YOUR_API_TOKEN_SALT_HERE
ADMIN_JWT_SECRET=YOUR_ADMIN_JWT_SECRET_HERE
JWT_SECRET=YOUR_JWT_SECRET_HERE
TRANSFER_TOKEN_SALT=YOUR_TRANSFER_TOKEN_SALT_HERE

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=PMTL

# ⭐ IMPORTANT: Meilisearch Configuration for 2GB VPS
# 
# Option A: USE MEILISEARCH CLOUD (RECOMMENDED) 🌟
# This saves ~700MB RAM and is free tier available
# Uncomment lines below and update values
# MEILISEARCH_HOST=https://your-meilisearch-instance.meilisearch.com
# MEILISEARCH_API_KEY=your-meilisearch-api-key

# Option B: DISABLE MEILISEARCH (use basic search)
# Remove strapi-plugin-meilisearch from dependencies
# PostgreSQL full-text search will work

# Option C: USE LOCAL MEILISEARCH (RISKY on 2GB)
# Add 2GB swap AND use docker-compose.prod.2gb.yml
# Uncomment in docker-compose.prod.2gb.yml
# MEILISEARCH_MASTER_KEY=your-secure-key

# Database SSL Configuration
DATABASE_SSL=false

# 🚨 2GB VPS SPECIFIC SETTINGS
# These are tuned for tight memory usage

# Disable unnecessary Strapi features
STRAPI_DISABLE_ADMIN_GRAPHQL=false

# Keep log level at warn to reduce memory
LOG_LEVEL=warn

# Reduce body parser limits if needed
BODY_SIZE_LIMIT=10mb

# Connection timeouts (tighter for low memory)
DATABASE_STATEMENT_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=30000

# Disable unused plugins (edit if not needed)
# STRAPI_DISABLE_PLUGIN_DOCUMENTATION=false
# STRAPI_DISABLE_PLUGIN_CLOUD=false

# Memory monitoring (for debugging only, disable in production)
# ENABLE_MEMORY_MONITORING=false
