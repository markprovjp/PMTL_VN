# ===================================
# Production Environment Variables
# ===================================
# IMPORTANT: Update these values with your actual production secrets!

# Node environment
NODE_ENV=production

# Database Configuration
# Use strong password in production!
DATABASE_NAME=strapi_db_prod
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=YOUR_STRONG_PASSWORD_HERE_32_CHARS_MIN
DATABASE_PORT=5432

# Backend Configuration
BACKEND_PORT=1337

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Strapi Keys - GENERATE NEW ONES!
# Generate with NodeJS:
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=YOUR_APP_KEYS_HERE
API_TOKEN_SALT=YOUR_API_TOKEN_SALT_HERE
ADMIN_JWT_SECRET=YOUR_ADMIN_JWT_SECRET_HERE
JWT_SECRET=YOUR_JWT_SECRET_HERE
TRANSFER_TOKEN_SALT=YOUR_TRANSFER_TOKEN_SALT_HERE

# Email Configuration for Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=PMTL

# SSL Configuration (when using Let's Encrypt)
DATABASE_SSL=false

# Backup and Maintenance
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
